# Local development: leave unset to use the Vite /api proxy.
# VITE_API_URL=http://127.0.0.1:8000

# For a Vercel multi-service deployment using the root vercel.json rewrites,
# leave this unset so the browser uses the same-origin /api routes.
# Only set it when intentionally using an independently hosted API.
# VITE_API_URL=https://your-api.example.com
